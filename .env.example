# NAFA — environment variables
#
# Copy to `.env` at the repo root and adjust. `.env` is git-ignored.
# Load order (first match wins): .env.<NODE_ENV>.local, .env.<NODE_ENV>,
# .env.local, .env — so `.env.test` overrides `.env` when NODE_ENV=test.
#
# Defaults below match infrastructure/docker/docker-compose.dev.yml.

# --- runtime ---
# NODE_ENV is deliberately NOT set here. Each tool sets it itself
# (`next build` -> production, `next dev` -> development, jest -> test), and a
# value in this file overrides them: Nx injects these variables into every
# task, so `NODE_ENV=development` would make production builds emit a
# development React bundle and fail at prerender.
SERVICE_NAME=nafa-iam
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgresql://nafa:nafa_dev_password@localhost:5432/nafa_dev

# --- Redis (cache + sessions) ---
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# --- Auth ---
# Minimum 32 characters, enforced at boot. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-secret-replace-me-with-48-random-bytes
JWT_EXPIRES_IN=1h

# --- Rate limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable output locally; must be false in production (JSON only).
LOG_PRETTY=true

# --- Telemetry (OpenTelemetry) ---
OTEL_ENABLED=true
# OTLP/HTTP collector. Traces are dropped when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Prometheus scrape endpoint: http://localhost:9464/metrics
PROMETHEUS_PORT=9464

# --- Kafka API (served by Redpanda in local dev) ---
KAFKA_BROKERS=localhost:9092

# --- RabbitMQ ---
RABBITMQ_URL=amqp://nafa:nafa_dev_password@localhost:5672

# --- Object storage (MinIO in local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nafa
S3_SECRET_KEY=nafa_dev_password
S3_BUCKET=nafa-dev

# --- Seed (bootstrap admin account) ---
SEED_ADMIN_EMAIL=admin@nafa.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
