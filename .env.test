# Test environment — committed on purpose so `NODE_ENV=test` works out of the
# box, locally and in CI, without anyone having to create a local file.
# Contains no real secret.

# NODE_ENV is set by the test runner, not here — see the note in .env.example.
SERVICE_NAME=nafa-iam-test
PORT=3001

DATABASE_URL=postgresql://nafa:nafa_dev_password@localhost:5432/nafa_test
REDIS_URL=redis://localhost:6379

JWT_SECRET=test-only-secret-value-that-is-long-enough-to-pass
JWT_EXPIRES_IN=15m

# Quiet logs and no telemetry export: tests should not emit either.
LOG_LEVEL=silent
LOG_PRETTY=false
OTEL_ENABLED=false
