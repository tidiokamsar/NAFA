generator client {
  provider = "prisma-client"
  output   = "../../services/foundation/iam/src/generated/prisma"
}

// Second generator — one Prisma client per consuming service (the established
// pattern). The geography service gets its own generated client so its
// imports are local and its build cache is independent. See
// docs/adr/0009-geography-master-boundaries.md.
generator geographyClient {
  provider = "prisma-client"
  output   = "../../services/masters/geography/src/generated/prisma"
}

// Third generator — same pattern for the products service. See
// docs/adr/0010-product-master-boundaries.md.
generator productsClient {
  provider = "prisma-client"
  output   = "../../services/masters/products/src/generated/prisma"
}

// Fourth generator — same pattern for the trade service. See
// docs/adr/0011-trade-master-boundaries.md.
generator tradeClient {
  provider = "prisma-client"
  output   = "../../services/masters/trade/src/generated/prisma"
}

// Fifth generator — the Actor Master finally gets its adapters. See
// docs/adr/0012-actor-persistence-boundaries.md.
generator actorClient {
  provider = "prisma-client"
  output   = "../../services/masters/actor/src/generated/prisma"
}

// The connection URL lives in services/foundation/iam/prisma.config.ts
// (Prisma 7 moved `url` out of the schema file).
datasource db {
  provider = "postgresql"
}

/// Standard audit columns.
///
/// Every table in NAFA carries these six fields. Prisma has no model
/// inheritance, so they are copied per model — keep the names and semantics
/// identical everywhere:
///
///   createdAt  set once on insert
///   updatedAt  refreshed by Prisma on every write
///   createdBy  id of the actor that created the row (null = system)
///   updatedBy  id of the actor that last wrote the row
///   deletedAt  soft delete marker; non-null rows must be filtered out
///   version    optimistic concurrency counter, incremented by the writer
///
/// Soft deletes are a convention, not a constraint: queries must filter on
/// `deletedAt: null` explicitly.

/// Technical account used for authentication. Not a business actor —
/// producers, buyers and organisations are separate models owned by the
/// masters layer.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([deletedAt])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Geography Master — GEO-002
//
// See docs/adr/0009-geography-master-boundaries.md and
//     packages/geography (the domain layer).
//
// The domain aggregates (CountryProfile, AdministrativeArea) expose
// snapshot()/rehydrate(); the Prisma adapters map between snapshots and these
// rows. Brand types (AdministrativeAreaId, AreaCode, CountryCode) are plain
// strings at the persistence layer — the mapper casts them.
// ---------------------------------------------------------------------------

/// Lifecycle of a country's administrative-areas template.
/// Mirrors `CountryProfileStatus` in @nafa/geography.
enum CountryProfileStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

/// Lifecycle of an individual administrative area.
/// Mirrors `AreaStatus` in @nafa/geography.
enum AreaStatus {
  ACTIVE
  MERGED
  SPLIT
  DISSOLVED
}

/// The position of an area in its country's hierarchy.
/// Mirrors `AdministrativeLevel` in @nafa/geography.
enum AdministrativeLevel {
  COUNTRY
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

/// The administrative-areas template for one country.
///
/// A country starts DRAFT, declares its level structure, then moves to
/// PUBLISHED before any area can be registered against it. The `levels` JSON
/// column holds the LevelDefinition[] (level + singular/plural labels) — it is
/// read whole because a profile carries at most four levels.
model CountryProfile {
  id          String                @id @default(uuid()) @db.Uuid
  countryCode String                @unique
  status      CountryProfileStatus  @default(DRAFT)
  levels      Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([deletedAt])
  @@index([status])
  @@map("country_profiles")
}

/// An actual administrative area — the place, not the template.
///
/// Identified by UUID. The code is unique per country+level (invariant 13,
/// enforced by the composite unique index). Parent links form the hierarchy;
/// `parentId` is null only for COUNTRY-level areas. Centroids are stored as
/// JSON {lat, lng} — polygons are deferred (ADR-0009 §7). Successors record
/// the areas that replaced a MERGED or SPLIT area so it stays resolvable.
model AdministrativeArea {
  id          String              @id @default(uuid()) @db.Uuid
  countryCode String
  level       AdministrativeLevel
  code        String
  name        Json
  parentId    String?             @db.Uuid
  centroid    Json?
  validFrom   String?
  validTo     String?
  status      AreaStatus          @default(ACTIVE)
  successors  Json                @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  /// Invariant 13 — AreaCode is unique per country+level.
  @@unique([countryCode, level, code])
  @@index([deletedAt])
  @@index([countryCode, parentId])
  @@index([countryCode, level])
  @@map("administrative_areas")
}

// ---------------------------------------------------------------------------
// Product Master — PROD-002
//
// See docs/adr/0010-product-master-boundaries.md and
//     packages/products (the domain layer).
//
// The domain aggregate exposes snapshot()/rehydrate(); the Prisma adapter maps
// between snapshots and rows. Brand types (ProductId, ProductCode) are plain
// strings at the persistence layer — the mapper casts them.
// ---------------------------------------------------------------------------

/// The generic taxonomy of tradeable products.
/// Mirrors `ProductCategory` in @nafa/products.
enum ProductCategory {
  CEREAL
  TUBER
  CASH_CROP
  HORTICULTURE
  LIVESTOCK
  FISHERY
  PROCESSED
}

/// Lifecycle of a catalogue product.
/// Mirrors `ProductStatus` in @nafa/products.
enum ProductStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

/// A tradeable product — the species itself, not a variety, a lot or an offer
/// (ADR-0010). The code is globally unique: the cashew is the cashew
/// everywhere, unlike an area code which is scoped per country.
model Product {
  id       String         @id @default(uuid()) @db.Uuid
  code     String         @unique
  category ProductCategory
  name     Json
  units    Json
  status   ProductStatus  @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([deletedAt])
  @@index([status])
  @@index([category])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Trade Master — TRA-002
//
// See docs/adr/0011-trade-master-boundaries.md and
//     packages/trade (the domain layer).
//
// Cross-Master references (sellerId, productId, pickupAreaId) are plain
// UUIDs with NO foreign keys: an offer references the other Masters by
// identity (ADR-0011 §3), it does not enforce their integrity — referential
// checks across Masters are the ports' questions, not the database's.
// ---------------------------------------------------------------------------

/// The lifecycle of an offer. Mirrors `OfferStatus` in @nafa/trade.
enum OfferStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
  CLOSED
}

/// An offer — a seller proposing a quantity of a product at a unit price,
/// available over a window, optionally located (ADR-0011).
model Offer {
  id             String      @id @default(uuid()) @db.Uuid
  sellerId       String      @db.Uuid
  productId      String      @db.Uuid
  quantityValue  Float
  unitCode       String
  priceAmountMinor Int
  currency       String
  pickupAreaId   String?     @db.Uuid
  availableFrom  String
  availableTo    String?
  status         OfferStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([deletedAt])
  @@index([sellerId])
  @@index([productId])
  @@index([pickupAreaId])
  @@index([status])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// ACTOR MASTER — economic actors and cooperative membership (ACTOR-002)
//
// The physical form of the aggregates in packages/foundation/src/actor.
// See docs/adr/0006-actor-and-cooperative-membership-boundaries.md,
//     docs/adr/0007-actor-regulatory-boundaries.md and
//     docs/adr/0012-actor-persistence-boundaries.md.
//
// Shape: the three-variant identity, the contacts, the address and the roles
// are JSON columns, because they are inside the aggregate's transactional
// boundary — they are never read or written without the actor they belong to,
// and joining four tables to load one actor would buy nothing.
//
// The exception is what has to be *searched*. `ActorRepository` asks three
// questions no aggregate can answer about itself — who holds this RCCM, this
// NIF, this phone number — so those three values are also stored as indexed
// columns. They are a projection of the JSON, written by the mapper on every
// save and never read back into the aggregate: the JSON stays the source of
// truth, the columns exist only so the database can answer.
// ---------------------------------------------------------------------------

/// Whether an actor is a natural person or a legal entity, and which kind.
/// Mirrors `ActorNature` in @nafa/foundation.
enum ActorNature {
  PERSON
  COMPANY
  COOPERATIVE
}

/// The actor lifecycle. CLOSED is terminal — see invariant 8.
/// Mirrors `ActorStatus` in @nafa/foundation.
enum ActorStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

/// How far identity checks have gone. Gates which roles may be held.
/// Mirrors `VerificationLevel` in @nafa/foundation.
enum VerificationLevel {
  NONE
  BASIC
  ENHANCED
}

/// An economic actor: a producer, a merchant, a transporter, a cooperative.
///
/// Distinct from `User`, which is a login. One person may have both, or a
/// User and no Actor, or an Actor recorded by an agent and no login at all.
model Actor {
  id           String            @id @default(uuid()) @db.Uuid
  nature       ActorNature
  identity     Json
  address      Json
  contacts     Json
  roles        Json
  status       ActorStatus       @default(DRAFT)
  verification VerificationLevel @default(NONE)

  /// Commercial register number, projected from `identity` for lookup.
  /// Unique across the registry: this is the database-level backstop behind
  /// ActorUniquenessChecker, not a replacement for it.
  rccm String? @unique

  /// Tax identifier, projected from `identity`. Optional for a person,
  /// required for a company or a cooperative — the domain enforces which.
  nif String? @unique

  /// Every phone number in `contacts`, projected for lookup. An array and
  /// not a unique column on purpose: sharing a handset is ordinary here, so
  /// `findByPhoneNumber` returns a list rather than treating it as a clash.
  phoneNumbers String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([deletedAt])
  @@index([status])
  @@index([nature])
  @@index([phoneNumbers], type: Gin)
  @@map("actors")
}

/// How a membership ended, or that it has not.
/// Mirrors `MembershipStatus` in @nafa/foundation.
enum MembershipStatus {
  ACTIVE
  RESIGNED
  EXCLUDED
}

/// One actor's membership of one cooperative.
///
/// Its own aggregate, hence its own table and its own version counter: a
/// cooperative may have thousands of members, and a member joining must not
/// collide with a contact being corrected (ADR-0006).
///
/// Both references are plain UUIDs with no foreign key. They point at rows in
/// `actors`, the same Master, but the aggregate holds ActorIds and never
/// Actors — the constraint that matters, at most one ACTIVE membership per
/// pair, is not expressible as a unique index and lives in the domain.
model CooperativeMembership {
  id            String           @id @default(uuid()) @db.Uuid
  cooperativeId String           @db.Uuid
  memberId      String           @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  admittedAt    String
  endedAt       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([deletedAt])
  @@index([cooperativeId, memberId])
  @@index([memberId])
  @@index([status])
  @@map("cooperative_memberships")
}
