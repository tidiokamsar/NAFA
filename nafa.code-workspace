{
  "folders": [
    { "name": "◆ racine (main — intégration)", "path": "." },
    { "name": "services", "path": "services" },
    { "name": "packages", "path": "packages" },
    { "name": "apps/web", "path": "apps/web" },
    { "name": "apps/mobile", "path": "apps/mobile" },
    { "name": "apps/ai", "path": "apps/ai" },
    { "name": "database", "path": "database" },
    { "name": "infrastructure", "path": "infrastructure" },
    { "name": "docs", "path": "docs" }
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.preferences.importModuleSpecifier": "non-relative",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
    "eslint.useFlatConfig": true,
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "npm.packageManager": "pnpm",
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.nx": true,
      "**/generated": true,
      "**/.expo": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.worktrees": true,
      "**/pnpm-lock.yaml": true,
      "**/generated": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.nx/**": true,
      "**/.worktrees/**": true
    },
    "git.autofetch": true,
    "git.confirmSync": true,
    "git.enableSmartCommit": false,
    "git.branchProtection": ["main"]
  },
  "extensions": {
    "recommendations": [
      "anthropic.claude-code",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "prisma.prisma",
      "bradlc.vscode-tailwindcss",
      "nrwl.angular-console",
      "ms-azuretools.vscode-docker",
      "expo.vscode-expo-tools",
      "orta.vscode-jest",
      "eamodio.gitlens",
      "deque-systems.vscode-axe-linter"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "infra: démarrer (sans les apps)",
        "type": "shell",
        "command": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d postgres redis redpanda rabbitmq minio minio-init",
        "problemMatcher": []
      },
      {
        "label": "infra: arrêter (conserve les volumes)",
        "type": "shell",
        "command": "docker compose -f infrastructure/docker/docker-compose.dev.yml stop",
        "problemMatcher": []
      },
      {
        "label": "check: affected",
        "type": "shell",
        "command": "npx nx affected -t lint typecheck test --base=origin/main",
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "deps: réinstaller proprement (pnpm)",
        "type": "shell",
        "command": "pnpm install --frozen-lockfile",
        "problemMatcher": []
      },
      {
        "label": "worktree: nouveau ticket",
        "type": "shell",
        "command": "git fetch origin && git worktree add .worktrees/${input:ticket} -b feature/${input:ticket}-${input:slug} origin/main",
        "problemMatcher": []
      }
    ],
    "inputs": [
      { "id": "ticket", "type": "promptString", "description": "Ticket (ex. SPR-0007)" },
      { "id": "slug", "type": "promptString", "description": "Slug court (ex. refresh-token)" }
    ]
  }
}
