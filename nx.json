{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/generated/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/database/schema/schema.prisma"
    ]
  },
  "targetDefaults": {
    "db:generate": {
      "cache": false,
      "outputs": [
        "{workspaceRoot}/services/foundation/iam/src/generated",
        "{workspaceRoot}/services/masters/geography/src/generated",
        "{workspaceRoot}/services/masters/products/src/generated",
        "{workspaceRoot}/services/masters/trade/src/generated"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        { "projects": ["@nafa/database"], "target": "db:generate" }
      ],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.next"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        { "projects": ["@nafa/database"], "target": "db:generate" }
      ],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default"],
      "cache": true
    },
    "test": {
      "dependsOn": [
        { "projects": ["@nafa/database"], "target": "db:generate" }
      ],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": [
        { "projects": ["@nafa/database"], "target": "db:generate" }
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "dependsOn": [{ "projects": ["@nafa/database"], "target": "db:generate" }]
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeLockfile": false
    }
  },
  "defaultBase": "main"
}
