# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build outputs
dist/
build/
out/
.next/
.nx/
.expo/
.expo-shared/
*.tsbuildinfo

# Prisma generated client
generated/

# Environment & secrets
.env
.env.*
!.env.example
# Committed on purpose: no real secrets, keeps NODE_ENV=test reproducible.
!.env.test
*.pem
*.key

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & coverage
coverage/
.nyc_output/

# Husky regenerates this on every install
.husky/_/

# Python (apps/ai, tooling)
__pycache__/
*.pyc
.venv/
venv/

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Portail des opportunités — données et documents produits par la
# couche de publication SharePoint (script 02), jamais versionnés.
# Le jeu d'archives constitué à la main vit dans
# apps/web/portail-opportunites/archives/, lui versionné.
apps/web/portail-opportunites/public/data/opportunites.json
apps/web/portail-opportunites/public/documents/

# OS & editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Mobile (React Native)
*.jks
*.p8
*.p12
*.mobileprovision
ios/Pods/
android/.gradle/
android/app/build/

# Worktrees des agents — voir docs/PARALLEL-AGENTS.md
.worktrees/

# pnpm est le seul gestionnaire de paquets de ce dépôt. Un package-lock.json
# ou un yarn.lock ici signifie qu'un `npm install` ou `yarn` a été lancé par
# erreur : il aplatit node_modules et fait résoudre NestJS en plusieurs
# instances. Le supprimer, puis `pnpm install --frozen-lockfile`.
package-lock.json
yarn.lock

# Sorties de génération documentaire, hors périmètre du monorepo
output/
tmp/
