# =================================================================
# Relais du portail AGEROUTE — variables d'environnement
# Copier en .env (jamais versionné) ou injecter par le gestionnaire
# de secrets de l'hébergement.
# =================================================================

PORT=8080

# --- Déclencheurs Power Automate (SECRETS — coffre uniquement) ----
# WF-05 : réception d'une candidature
URL_FLUX_CANDIDATURES=
# WF-08 flux A : inscription à la liste de diffusion
URL_FLUX_ABONNEMENT=
# WF-08 flux B : confirmation du double opt-in
URL_FLUX_CONFIRMATION=
# WF-08 flux C : désabonnement
URL_FLUX_DESABONNEMENT=

# Clé partagée ajoutée à chaque appel ; le flux la contrôle en
# première condition et termine en échec 401 si elle ne correspond pas.
CLE_PARTAGEE=
ENTETE_CLE_PARTAGEE=x-cle-relais
DELAI_FLUX_MS=30000

# --- CAPTCHA -----------------------------------------------------
# turnstile | recaptcha | hcaptcha | aucun
CAPTCHA_FOURNISSEUR=turnstile
CAPTCHA_SECRET=
CAPTCHA_DELAI_MS=8000

# --- Catalogue publié (contrôle EXG-26) --------------------------
# URL du JSON publié, ou chemin local si le relais est sur le même
# serveur que le front.
SOURCE_CATALOGUE=https://opportunites.ageroute.gov.gn/data/opportunites.json
CATALOGUE_CACHE_MS=120000
# true : un catalogue injoignable bloque les dépôts (503).
# false : le contrôle de clôture est délégué à WF-05.
CATALOGUE_OBLIGATOIRE=false

# --- Contraintes de dépôt (EXG-22) -------------------------------
EXTENSIONS_AUTORISEES=pdf,docx,jpg,jpeg,png
TAILLE_MAX_FICHIER_MO=10
TAILLE_MAX_TOTAL_MO=30
NOMBRE_MAX_PIECES=10
TAILLE_MAX_CORPS_MO=48

# --- Limitation de débit -----------------------------------------
LIMITE_CANDIDATURES_HEURE=5
LIMITE_ABONNEMENTS_HEURE=10
LIMITE_REQUETES_MINUTE=30

# --- Réseau ------------------------------------------------------
# true uniquement si le service est derrière un proxy maîtrisé
# (Nginx, Application Gateway) qui réécrit X-Forwarded-For.
PROXY_DE_CONFIANCE=false
# Vide si le front est servi sur la même origine (cas nominal).
ORIGINES_AUTORISEES=

# Dossier public à servir (déploiement mono-serveur). Laisser vide
# si le front est hébergé séparément.
RACINE_STATIQUE=
