{
  "name": "nafa",
  "version": "0.1.0",
  "private": true,
  "description": "NAFA — Enterprise Monorepo",
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "apps/web/*",
    "apps/mobile/*",
    "apps/ai/*",
    "apps/whatsapp",
    "apps/ussd",
    "apps/api-portal",
    "services/*/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t test:e2e",
    "typecheck": "nx run-many -t typecheck",
    "db:generate": "nx run-many -t db:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nx": "^23.1.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
