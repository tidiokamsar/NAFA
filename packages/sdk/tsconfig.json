{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "baseUrl": "./",
    // The SDK must run in a browser too (Next.js portals), so DOM types are
    // needed for fetch/AbortController rather than Node-only equivalents.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
